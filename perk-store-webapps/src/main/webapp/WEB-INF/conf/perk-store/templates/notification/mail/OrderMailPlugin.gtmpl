<table border="0" cellpadding="0" cellspacing="0" width="100%" bgcolor="#ffffff" align="center" style="width:100%;overflow-wrap:anywhere;word-break:break-word;background-color: #ffffff; font-size: 15px;color: #1d2327;line-height: 1.7;font-family: ${io.meeds.portal.mail.EmailLayout.fontStack()};" dir="${io.meeds.portal.mail.EmailLayout.dir(_ctx.language)}">
    <%
      String headerTitle;
      if ("true".equals(isNewOrder)) {
        headerTitle = _ctx.appRes("Notification.title.OrderAddedNotificationPlugin", productTitle, orderId);
      } else {
        headerTitle = _ctx.appRes("Notification.title.OrderModifiedNotificationPlugin", productTitle, orderId);
      }
      _templateContext.put("header_title", headerTitle);
      _ctx.include("war:/notification/templates/mail/NotificationHeader.gtmpl", _templateContext);
    %>
    <tr>
        <td style="padding:0 24px;">
            <table role="presentation" cellpadding="0" cellspacing="0" width="100%" bgcolor="#ffffff" style="max-width:600px;margin:0 auto;background-color: #ffffff;">
                <tr>
                    <td bgcolor="#ffffff" style="background-color: #ffffff;">
                        <table border="0" cellpadding="0" cellspacing="0" width="100%" bgcolor="#ffffff" style="background-color: #ffffff; color: #1d2327;line-height: 1.7;">
                            <tr>
                                <td align="${io.meeds.portal.mail.EmailLayout.start(_ctx.language)}" bgcolor="#ffffff" style="background-color: #ffffff;padding: 30px 0 10px 0;">
                                    <p style="margin: 0 0 14px; font-size: 15px; color: #1d2327; font-family: ${io.meeds.portal.mail.EmailLayout.fontStack()};"><%=_ctx.appRes("Notification.label.SayHello")%> <%=_ctx.escapeHTML(FIRSTNAME)%>,</p>
                                    <p style="margin:0 0 14px; color:#1d2327; line-height:1.7; font-size:15px; font-family: ${io.meeds.portal.mail.EmailLayout.fontStack()};" dir="auto">
                                      <%
                                        String senderLink = "<a target=\"_blank\" style=\"color: ${io.meeds.portal.mail.EmailLayout.linkColor()}; text-decoration: none; font-weight: bold; font-family: ${io.meeds.portal.mail.EmailLayout.fontStack()};\" href=\"" + senderUrl + "\">" + _ctx.escapeHTML(senderName) + "</a>";
                                        String message = null;
                                        String orderLink = "<a target=\"_blank\" style=\"color: ${io.meeds.portal.mail.EmailLayout.linkColor()}; text-decoration: none; font-weight: bold; font-family: ${io.meeds.portal.mail.EmailLayout.fontStack()};\" href=\"" + detailsURL + "\">#" + orderId + "</a>";
                                        if("true".equals(isNewOrder)) {
                                         message = _ctx.appRes("Notification.perkstore.order.created", senderLink, orderQuantity, _ctx.escapeHTML(productTitle), orderLink);
                                        } else {
                                         String modifierLink = "<a target=\"_blank\" style=\"color: ${io.meeds.portal.mail.EmailLayout.linkColor()}; text-decoration: none; font-weight: bold; font-family: ${io.meeds.portal.mail.EmailLayout.fontStack()};\" href=\"javascript:void(0)\">" + _ctx.escapeHTML(modifierName) + "</a>";
                                         String key = "Notification.perkstore.order.modified." + orderStatusLabel;
                                         if (org.apache.commons.lang3.StringUtils.isBlank(modifierName)) {
                                           // System modification
                                           key += ".system";
                                         }
                                         if("true".equals(isOrderSender)) {
                                           // Is sender modification
                                           key += ".you";
                                         }
                                         message = _ctx.appRes(key, senderLink, modifierLink, orderQuantity, _ctx.escapeHTML(productTitle), symbol, orderRefundedAmount, orderRefundedQuantity, orderDeliveredQuantity, orderLink);
                                        }
                                      %> 
                                      <%= message %>
                                    </p>
                                    <table border="0" cellpadding="0" cellspacing="0" width="100%" bgcolor="#ffffff" align="center" style="background-color: #ffffff; font-size: 15px;color: #1d2327;line-height: 1.7;">
                                        <tbody>
                                            <tr>
                                                <td align="${io.meeds.portal.mail.EmailLayout.start(_ctx.language)}" bgcolor="#ffffff" style="background-color: #ffffff; padding: 0;">
                                                    <p style="margin:0 0 14px; color:#1d2327; line-height:1.7; font-size:15px; font-family: ${io.meeds.portal.mail.EmailLayout.fontStack()};" dir="auto">
                                                      <%= _ctx.appRes("Notification.perkstore.order.status") %>: <%= orderStatus %>
                                                    </p>
                                                    <% if(org.apache.commons.lang3.StringUtils.equalsIgnoreCase(orderStatus, "error")) { %>
                                                      <p style="margin:0 0 14px; color:#1d2327; line-height:1.7; font-size:15px; font-family: ${io.meeds.portal.mail.EmailLayout.fontStack()};" dir="auto">
                                                        <%= _ctx.appRes("Notification.perkstore.order.error") %>
                                                      </p>
                                                    <% } %>
                                                    <p style="margin:0 0 14px; color:#1d2327; line-height:1.7; font-size:15px; font-family: ${io.meeds.portal.mail.EmailLayout.fontStack()};" dir="auto">
                                                      <%= _ctx.appRes("Notification.perkstore.order.quantity") %>: <%= orderQuantity %>
                                                    </p>
                                                    <% if(org.apache.commons.lang3.StringUtils.isNotBlank(orderDeliveredQuantity) && !org.apache.commons.lang3.StringUtils.equalsIgnoreCase(orderDeliveredQuantity, "0")) { %>
                                                      <p style="margin:0 0 14px; color:#1d2327; line-height:1.7; font-size:15px; font-family: ${io.meeds.portal.mail.EmailLayout.fontStack()};" dir="auto">
                                                        <%= _ctx.appRes("Notification.perkstore.order.deliveredQuantity") %>: <%= orderDeliveredQuantity %>
                                                      </p>
                                                    <% } %>
                                                    <% if(org.apache.commons.lang3.StringUtils.isNotBlank(orderRefundedQuantity) && !org.apache.commons.lang3.StringUtils.equalsIgnoreCase(orderRefundedQuantity, "0")) { %>
                                                      <p style="margin:0 0 14px; color:#1d2327; line-height:1.7; font-size:15px; font-family: ${io.meeds.portal.mail.EmailLayout.fontStack()};" dir="auto">
                                                        <%= _ctx.appRes("Notification.perkstore.order.refundedQuantity") %>: <%= orderRefundedQuantity %>
                                                      </p>
                                                    <% } %>
                                                    <% if(org.apache.commons.lang3.StringUtils.isNotBlank(orderRemainingQuantity) && !org.apache.commons.lang3.StringUtils.equalsIgnoreCase(orderRemainingQuantity, "0")) { %>
                                                      <p style="margin:0; color:#1d2327; line-height:1.7; font-size:15px; font-family: ${io.meeds.portal.mail.EmailLayout.fontStack()};" dir="auto">
                                                        <%= _ctx.appRes("Notification.perkstore.order.remainingQuantity") %>: <%= orderRemainingQuantity %>
                                                      </p>
                                                    <% } %>
                                                </td>
                                            </tr>
                                        </tbody>
                                    </table>
                                    <div dir="${io.meeds.portal.mail.EmailLayout.dir(_ctx.language)}" style="margin: 20px 0 8px 0;">
                                        <%=io.meeds.portal.mail.EmailLayout.actionLink(_ctx.appRes("Notification.perkstore.ViewDetails"), detailsURL, true)%>
                                    </div>
                                </td>
                            </tr>
                        </table>
                    </td>
                </tr>
            </table>            
        </td>
    </tr><!--end content area-->
    <% _ctx.include("war:/notification/templates/mail/NotificationFooter.gtmpl", _templateContext);%>
</table>